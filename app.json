{
  "expo": {
    "version": "1.1.0",
    "name": "سَرد",
    "slug": "sard",
    "scheme": [
      "sard",
      "lnreader"
    ],
    "icon": "./assets/native/ic_launcher.png",
    "plugins": [
      "./plugins/withAndroidCustomizations",
      [
        "expo-splash-screen",
        {
          "image": "./assets/native/ic_launcher_round.png",
          "backgroundColor": "#1D1B20",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/native/ic_launcher_round.png",
            "backgroundColor": "#000000"
          },
          "android": {
            "image": "./assets/native/splash_icon.png",
            "backgroundColor": "#132C33",
            "imageWidth": 288,
            "resizeMode": "native",
            "dark": {
              "image": "./assets/native/splash_icon.png",
              "backgroundColor": "#132C33"
            }
          }
        }
      ],
      "expo-localization",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "enforceNavigationBarContrast": false
          }
        }
      ],
      "expo-web-browser",
      "./plugins/withReaderAssets",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم سَرد Face ID لفتح قفل التطبيق والرف المخفي."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "يحتاج سَرد إلى الكاميرا لمسح رمز QR الخاص بمستودع الإضافات.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "manifestApplicationAttributes": {
              "android:largeHeap": "true",
              "android:allowBackup": "true"
            },
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "android": {
      "versionCode": 2,
      "package": "app.sard.reader",
      "adaptiveIcon": {
        "foregroundImage": "./assets/native/ic_launcher_foreground.png",
        "backgroundImage": "./assets/native/ic_launcher_background.png",
        "monochromeImage": "./assets/native/ic_launcher_monochrome.png"
      },
      "permissions": [
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "app.sard.reader",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    }
  }
}
